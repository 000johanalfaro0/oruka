{
  "id": "agy",
  "name": "Agy",
  "icon": "sparkle",
  "detect": {
    "bin": "agy",
    "versionArgs": [
      "--version"
    ]
  },
  "launch": {
    "args": [],
    "cwd": "flag",
    "cwdFlag": "--add-dir"
  },
  "modes": {
    "default": [],
    "yolo": [
      "--dangerously-skip-permissions"
    ],
    "plan": [
      "--mode",
      "plan"
    ],
    "acceptEdits": [
      "--mode",
      "accept-edits"
    ]
  },
  "resume": [
    "--continue"
  ],
  "prompt": {
    "via": "arg",
    "flag": "--prompt-interactive"
  },
  "mcp": {
    "format": "claude-json",
    "path": "~/.gemini/config/mcp_config.json",
    "key": "mcpServers"
  },
  "roles": {
    "file": "GEMINI.md",
    "role": "Explorador",
    "brief": "Rastrea el código y las dependencias para responder preguntas. No modifica archivos salvo que se le pida."
  },
  "install": {
    "command": "winget",
    "args": [
      "install",
      "--id",
      "Google.AntigravityCLI",
      "-e",
      "--accept-source-agreements",
      "--accept-package-agreements"
    ]
  }
}
